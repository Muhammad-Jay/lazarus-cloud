# Lazarus — Git attributes
#
# Line endings: the repo stores LF. Checked-out files are converted to native
# endings on Windows so tooling behaves, but the committed blob is always LF.
* text=auto eol=lf

# ── Files that must stay LF even on Windows ────────────────────────────────
*.sh        text eol=lf
justfile    text eol=lf
*.go        text eol=lf

# ── Generated: collapse diffs, reviewers read the source of truth ────────────
# Lockfiles are generated by the package manager. `*.sln` is hand-authored and is
# deliberately NOT here.
pnpm-lock.yaml                 linguist-generated=true -diff
package-lock.json              linguist-generated=true -diff
yarn.lock                      linguist-generated=true -diff
go.sum                         linguist-generated=true -diff
pnpm-workspace.yaml            linguist-generated=true -diff

# ── Generated contracts ─────────────────────────────────────────────────────
# Regenerated by `pnpm codegen`. An edit here is lost on the next run
# (AGENTS.md §4.7), and `contract-drift` CI fails on any hand edit.
#
# Only the `src/generated/` directories are marked. The schemas themselves are the
# SOURCE OF TRUTH, and marking `packages/contracts/**` would collapse the diff of
# an authored contract change into something a reviewer never reads.
packages/contracts/src/generated/           linguist-generated=true -diff
packages/spec/src/generated/                linguist-generated=true -diff
apps/control-plane/**/Generated/**          linguist-generated=true -diff
apps/control-plane/src/Lazarus.Api/openapi.json   linguist-generated=true -diff

# ── Documentation ──────────────────────────────────────────────────────────
*.md                    text eol=lf
docs/                   linguist-documentation
docs/adr/               linguist-documentation

# ── Binary ─────────────────────────────────────────────────────────────────
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.mp4    binary
*.webm   binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary

# ── Diff drivers for domain-ish files ──────────────────────────────────────
*.cs  diff=csharp
*.go  diff=golang