# Lazarus — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Everything here must be satisfiable on a single machine with no external
# account. See AGENTS.md §1 — self-hostable is a hard constraint, so there is no
# value in this file that requires a hosted service.
#
# Everything observable is optional: with the observability values below left
# unset, the platform runs and exports nothing. An unset exporter is a no-op,
# not an error.
#
# Exactly two values must be generated before the platform can start:
# BETTER_AUTH_SECRET (session signing) and LAZARUS_MASTER_KEY (secret
# encryption). Generate them, then never commit the result — `.env` is
# gitignored and this file is not.
#
# Generate secrets with:  openssl rand -base64 48


# ── Core ───────────────────────────────────────────────────────────────────

# Install-time configuration, never hardcoded in source (AGENTS.md §1).
# The domain Lazarus's own UI and API are served from. `lazarus.local` is the
# LAN-only case: it is honoured with a self-signed CA and never assumes a real
# certificate exists.
LAZARUS_BASE_DOMAIN=lazarus.local

# Public address of the control-plane API.
LAZARUS_API_URL=https://lazarus.local

# Comma-separated origins permitted to call the API and open realtime
# connections. Leave unset on a LAN-only install.
LAZARUS_ALLOWED_ORIGINS=

# Set to `true` only for local development. Never in a real deployment.
# TLS degrades honestly, in three steps: an owned domain gets a real ACME
# certificate; no domain gets a self-signed CA and a LAN hostname; and this
# flag serves plain HTTP for local development. No code path assumes a real
# certificate.
LAZARUS_DEV_MODE=false


# ── Identity (services/auth) ───────────────────────────────────────────────

# Signing secret for Better Auth sessions. REQUIRED. Rotating this invalidates
# every existing session.
BETTER_AUTH_SECRET=

# Public base URL of the auth service. Better Auth derives JWT `iss`/`aud` from
# this, so it MUST match what the control-plane validates.
BETTER_AUTH_URL=https://lazarus.local/auth

# Signing algorithm for issued JWTs. MUST stay `ES256`: the .NET control-plane
# validates against JWKS with `JwtBearer`, which needs an algorithm it supports
# without extra configuration. Do not change without an ADR.
BETTER_AUTH_JWT_ALG=ES256

# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are gone with GitHub source sync:
# there is no connected-repository import and no GitHub App install flow
# (ADR-0012). Publishing reads a `lazarus.yaml` or `lazarus.json` submitted
# directly or over the API.

# Maps an authenticated organisation to a Lazarus tenant. Used for the very
# first tenant only; thereafter this is per-tenant data in Postgres.
LAZARUS_DEFAULT_TENANT_NAME=


# ── Database ───────────────────────────────────────────────────────────────

POSTGRES_USER=lazarus
POSTGRES_PASSWORD=
POSTGRES_DB=lazarus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Connection string assembled by the compose file from the values above.
# Set directly only when running outside compose.
LAZARUS_DATABASE_URL=


# ── Control plane ──────────────────────────────────────────────────────────

# Master key for secret envelope encryption. REQUIRED for the Secrets module.
# Losing this makes every stored secret unrecoverable.
LAZARUS_MASTER_KEY=

# Rootless podman socket. Control-plane only; never exposed to the web app.
PODMAN_SOCKET=unix:///run/user/1000/podman/podman.sock

# Signing key for the session/cookie signing the web app presents to the
# control-plane. Distinct from BETTER_AUTH_SECRET.
LAZARUS_WEB_SIGNING_KEY=


# ── Container runtime ──────────────────────────────────────────────────────

# Rootless images may only be pulled from these registries. Anything else is
# denied by Policy — see AGENTS.md §4.5. Environments are digest-pinned; a tag
# is not an identity.
LAZARUS_ALLOWED_REGISTRIES=docker.io,ghcr.io,quay.io

# LAZARUS_ALLOWED_BASE_IMAGES, LAZARUS_PORT_RANGE_START,
# LAZARUS_PORT_RANGE_END, and LAZARUS_WORKSPACE_ROOT are gone with delivery.
# An environment is a prepared, digest-pinned image plus a temporary writable
# session layer, not something built from a base image and published on a
# host port. A session has no ingress route and is never published (ADR-0012).


# ── TLS ────────────────────────────────────────────────────────────────────

# Lazarus's own hostname only. ACME is for the install's UI and API; it is
# never issued for a user workload, because no user workload is ever published
# (ADR-0012, which supersedes the wildcard-routing decision in ADR-0006).
#
# Uncomment only if the install owns a real domain. Without it, TLS degrades to
# a self-signed CA and a LAN hostname rather than failing.
# LAZARUS_ACME_EMAIL=ops@example.com
LAZARUS_ACME_ENABLED=false


# ── Observability (all optional, all default to no-op) ──────────────────────

# Every exporter below is optional by default and must degrade to a no-op
# rather than to a failure (AGENTS.md §1). An empty OTLP endpoint or a disabled
# exporter means nothing is sent, and the platform starts and runs normally.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_ENABLED=false

# Empty DSN means the error reporter is never initialised. No key, no calls.
SENTRY_DSN=

LAZARUS_LOG_LEVEL=Information
LAZARUS_LOG_FORMAT=json