{
  "name": "@lazarus/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "The single source of every colour, spacing, radius, shadow and motion value. Leaf package: no dependencies.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./src/generated/tokens.css",
    "./tokens.json": "./src/tokens.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
