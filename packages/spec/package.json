{
  "name": "@lazarus/spec",
  "version": "0.0.0",
  "private": true,
  "description": "The experience contract: lazarus.schema.json and its generated types.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./experience": "./src/generated/experience.ts",
    "./schema": "./lazarus.schema.json"
  },
  "files": [
    "lazarus.schema.json",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "fmt": "prettier --write . --ignore-path ../../.prettierignore",
    "fmt-check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "prettier": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@lazarus/config": "workspace:*"
  }
}
