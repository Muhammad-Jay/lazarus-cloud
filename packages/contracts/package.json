{
  "name": "@lazarus/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Generated interaction and session types. Never hand-edited.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interaction": {
      "types": "./dist/generated/interaction.d.ts",
      "default": "./dist/generated/interaction.js"
    },
    "./session": {
      "types": "./dist/generated/session.d.ts",
      "default": "./dist/generated/session.js"
    },
    "./schema/*": "./src/schema/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . --cache",
    "fmt": "prettier --write . --ignore-path ../../.prettierignore",
    "fmt-check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "prettier": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@lazarus/config": "workspace:*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
